# Copy to .env and fill in the real value (never commit .env).
#
# InfluxDB token — used by both sensor-writer and cr300-collector.
# IMPORTANT: the old token was committed to git earlier. Rotate it in InfluxDB
# (create a new token, delete the old one) and put the NEW token here.
INFLUX_TOKEN=paste-new-influxdb-token-here
